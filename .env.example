# Copy to .env and fill in real values.
# Generate a strong secret with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string
SITE_URL=https://learnwithpython.com
# Leave DATABASE_URL empty to use the local SQLite file below.
# Set it to a Postgres connection string and the app uses that instead —
# accounts, XP, streaks and progress then survive restarts and deploys.
# Supabase: Project Settings -> Database -> Connection string -> URI,
# and replace [YOUR-PASSWORD] with your database password.
#   DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
DATABASE_URL=

DATABASE_PATH=learnwithpython.db
FLASK_DEBUG=1
PORT=5000
# Set to 1 in production (behind HTTPS) so the session cookie is Secure.
SESSION_COOKIE_SECURE=0

# ── Google Sign-In (OAuth 2.0) ───────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:  {SITE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Supabase ─────────────────────────────────────────────────────────
# From your Supabase project settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Transactional email (optional) ──────────────────────────────────────
# Unset, the welcome email is silently skipped and signup works normally.
# Get a key at resend.com, then verify learnwithpython.com as a sending
# domain (add the SPF + DKIM records it gives you) or mail will land in spam.
RESEND_API_KEY=
MAIL_FROM=LearnWithPython <hello@learnwithpython.com>

# ── Supabase Auth (GoTrue) ──────────────────────────────────────────────
# Dashboard -> Settings -> API. Identity lives in auth.users; the app keeps
# only a profile row keyed by that UUID.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Server-side only. Bypasses Row Level Security - never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=
